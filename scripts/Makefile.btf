# SPDX-License-Identifier: GPL-2.0

pahole-ver := $(CONFIG_PAHOLE_VERSION)
pahole-flags-y :=

JOBS := $(patsubst -j%,%,$(filter -j%,$(MAKEFLAGS)))

ifeq ($(call test-le, $(pahole-ver), 125),y)

pahole-flags-y                                  	+= --btf_gen_floats -j$(JOBS)

pahole-flags-$(call test-ge, $(pahole-ver), 125)	+= --skip_encoding_btf_inconsistent_proto --btf_gen_optimized

else

# Switch to using --btf_features for v1.26 and later.
# Note: pahole drops DW_OP_plus_uconst on section-anchored .data..percpu
# variables emitted by Clang -Os/-Oz, causing duplicate DATASEC offsets in
# btf_datasec_check_meta(). Omit 'var' under CONFIG_CC_OPTIMIZE_FOR_SIZE.
ifeq ($(CONFIG_CC_OPTIMIZE_FOR_SIZE),y)
pahole-btf-var-feature :=
else
pahole-btf-var-feature := var,
endif
pahole-flags-$(call test-ge, $(pahole-ver), 126)  = -j$(JOBS) --btf_features=encode_force,$(pahole-btf-var-feature)float,enum64,decl_tag,type_tag,optimized_func,consistent_func,decl_tag_kfuncs

pahole-flags-$(call test-ge, $(pahole-ver), 130) += --btf_features=attributes

endif

pahole-flags-$(CONFIG_PAHOLE_HAS_LANG_EXCLUDE)		+= --lang_exclude=rust

export PAHOLE_FLAGS := $(pahole-flags-y)

resolve-btfids-flags-y :=
resolve-btfids-flags-$(CONFIG_WERROR) += --fatal_warnings
resolve-btfids-flags-$(if $(KBUILD_EXTMOD),y) += --distill_base
resolve-btfids-flags-$(if $(KBUILD_VERBOSE),y) += --verbose

export RESOLVE_BTFIDS_FLAGS := $(resolve-btfids-flags-y)
