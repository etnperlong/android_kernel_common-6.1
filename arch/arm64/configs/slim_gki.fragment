# Core size & CPU scaling
# CONFIG_AUTOFDO_CLANG is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
# Use static Shadow Call Stack (CONFIG_SHADOW_CALL_STACK=y) without runtime .eh_frame PAC patching
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
CONFIG_BPF_PROG_PACK_SHIFT=14
CONFIG_NR_CPUS=8
CONFIG_LOG_BUF_SHIFT=16
CONFIG_SLAB_MERGE_DEFAULT=y
# CONFIG_SLUB_CPU_PARTIAL is not set
CONFIG_SERIAL_8250_NR_UARTS=4

# Pre-approved TV-GKI 6.12 baseline cuts (keeping Shadow Call Stack enabled)
# CONFIG_ANDROID_KABI_RESERVE is not set
# CONFIG_ANDROID_VENDOR_OEM_DATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_KVM is not set
# CONFIG_PTDUMP_STAGE2_DEBUGFS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_PAGE_PINNER is not set
# CONFIG_IKHEADERS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_CMA_DEBUGFS is not set
# CONFIG_SW_SYNC is not set
# CONFIG_KUNIT is not set
# CONFIG_KUNIT_DEBUGFS is not set
# CONFIG_KUNIT_TEST is not set
# CONFIG_KUNIT_EXAMPLE_TEST is not set
# CONFIG_TIME_KUNIT_TEST is not set
# CONFIG_NETDEV_ADDR_LIST_TEST is not set
# CONFIG_REGMAP_KUNIT is not set
# CONFIG_INPUT_KUNIT_TEST is not set
# CONFIG_SND_SOC_TOPOLOGY_KUNIT_TEST is not set
# CONFIG_SND_SOC_UTILS_KUNIT_TEST is not set
# CONFIG_HID_KUNIT_TEST is not set
# CONFIG_RTC_LIB_KUNIT_TEST is not set
# CONFIG_CLK_KUNIT_TEST is not set
# CONFIG_CLK_GATE_KUNIT_TEST is not set
# CONFIG_IIO_FORMAT_KUNIT_TEST is not set
# CONFIG_ANDROID_BINDER_ALLOC_KUNIT_TEST is not set
# CONFIG_EXT4_KUNIT_TESTS is not set
# CONFIG_FAT_KUNIT_TEST is not set
# Keep vmlinux BTF enabled for Mainline Connectivity @funcs.o (b/544506641), skip module BTF.
# Use DWARFv4 so pahole v1.27 encodes -Os .data..percpu offsets via direct DW_OP_addr.
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_MODULE_ALLOW_BTF_MISMATCH is not set
# CONFIG_SCHED_CLASS_EXT is not set

# Hypervisor host & enterprise storage bloat unused on 1-2GB devices
# CONFIG_GUNYAH is not set
# CONFIG_GUNYAH_IRQFD is not set
# CONFIG_GUNYAH_IOEVENTFD is not set
# CONFIG_GUNYAH_QCOM_TRUSTED_VM is not set
# CONFIG_VFIO is not set
# CONFIG_VFIO_PKVM_IOMMU is not set
# CONFIG_VFIO_PLATFORM is not set
# CONFIG_PKVM_PVIOMMU is not set
# CONFIG_VHOST_VSOCK is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_MTK_GZVM is not set
# CONFIG_BLK_DEV_RAM is not set
CONFIG_BLK_DEV_RAM_SIZE=8192 # nocheck: BLK_DEV_RAM is disabled
# CONFIG_BLK_DEV_UBLK is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_POWER_RESET_HISI is not set
# CONFIG_SCSI_UFS_HISI is not set
# CONFIG_PCIE_KIRIN is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TEGRA_234_SOC is not set
# CONFIG_TEGRA_BPMP is not set
# CONFIG_TEGRA_HSP_MBOX is not set
# CONFIG_SERIAL_TEGRA_TCU is not set
# CONFIG_USB4 is not set
# CONFIG_TYPEC_TBT_ALTMODE is not set
# CONFIG_CORESIGHT is not set
# CONFIG_CORESIGHT_SOURCE_ETM4X is not set
# CONFIG_CORESIGHT_TRBE is not set
# CONFIG_DWC_PCIE_PMU is not set
# CONFIG_NET_9P is not set
# CONFIG_PPTP is not set
# CONFIG_WWAN is not set
# CONFIG_USB_MON is not set

# Sanitizers, allocation codetags, dynamic debug & function-entry NOPs
# CONFIG_MEM_ALLOC_PROFILING is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# Keep CONFIG_KFENCE=y for 100% VINTF compliance while setting sample_interval=0 so 0 bytes of memblock pool are allocated at boot
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=0
# CONFIG_DYNAMIC_DEBUG_CORE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_HIST_TRIGGERS is not set
# CONFIG_TRACE_MMIO_ACCESS is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_EPROBE_EVENTS is not set
# CONFIG_DAMON is not set
# CONFIG_PARAVIRT is not set
# CONFIG_PARAVIRT_TIME_ACCOUNTING is not set

# Keep core parent menus & USB, LEDs & Media frameworks built-in when savedefconfig leaf selectors are disabled
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PCIEPORTBUS=y
CONFIG_MAILBOX=y
CONFIG_INTERCONNECT=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_USB=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_BRIDGE=m
CONFIG_WIREGUARD=m
CONFIG_EXFAT_FS=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_GSPCA=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_HID_APPLE=m
CONFIG_HID_ELECOM=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PICOLCD=m
CONFIG_HID_PLANTRONICS=m
CONFIG_HID_PRODIKEYS=m
CONFIG_HID_ROCCAT=m
CONFIG_HID_STEAM=m
CONFIG_HID_UCLOGIC=m
CONFIG_HID_WACOM=m
CONFIG_HID_WIIMOTE=m
CONFIG_VIRTIO_FS=m
CONFIG_DRM=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_EHCI_HCD_PLATFORM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_DWC3=m
CONFIG_TYPEC=m
CONFIG_TYPEC_TCPM=m
CONFIG_TYPEC_TCPCI=m
CONFIG_TYPEC_UCSI=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PCI=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_DWC_TC_PLATFORM=m

